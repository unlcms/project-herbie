{{ attach_library('unl_six_herbie/cta') }}
{% set attributes = attributes ?: create_attribute() %}
{% set call_to_action_classes = ['unlcms-component-spacer', 'unlcms-cta-block', 'dcf-ct-inline-size'] %}
{{ attach_library('unl_six_herbie/cta') }}

<div{{ attributes.addclass(call_to_action_classes) }}>
  <div class="unlcms-cta-wrap dcf-d-grid dcf-ai-center dcf-col-gap-vw dcf-row-gap-4">

    {{ title_prefix }}
    {{ title_suffix }}
    {% block cta_title %}
      <div class="unlcms-cta-title dcf-d-flex dcf-ai-center dcf-jc-center">
        {{ content.b_cta_title }}
      </div>
    {% endblock %}

    {% block cta_summary %}
      <div class="unlcms-cta-summary dcf-d-flex dcf-ai-center dcf-jc-center dcf-txt-center">
        {{ content.b_cta_summary }}
      </div>
    {% endblock %}

    {% block cta_link %}
      <div class="unlcms-cta-btn-group dcf-d-flex dcf-flex-wrap dcf-ai-center dcf-jc-center dcf-col-gap-4 dcf-row-gap-3">
        {{ content.b_cta_link }}
      </div>
    {% endblock %}

  </div>
</div>
